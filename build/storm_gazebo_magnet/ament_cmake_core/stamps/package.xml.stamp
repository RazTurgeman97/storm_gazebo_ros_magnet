<?xml version="1.0"?>
<package format="3">
  <name>storm_gazebo_magnet</name>
  <version>0.1.0</version>
  <description>
    A Gazebo (Fortress) plugin that computes the force and torque between multiple magnets,
    designed for ROS 2 Humble.
  </description>
  <maintainer email="your_email@example.com">Raz Turgeman</maintainer>
  <license>Apache 2.0</license>

  <!-- Dependencies -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Runtime dependencies -->
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>ignition-gazebo6</depend>
  <depend>ignition-math6</depend>
  <depend>ignition-plugin1</depend>

  <!-- Test dependencies (optional) -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <!-- Export -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
